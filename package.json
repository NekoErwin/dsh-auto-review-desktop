{
  "name": "dsh-auto-review-desktop",
  "version": "0.4.4",
  "type": "module",
  "description": "Independent DSH Desktop authorization review with bounded execution and native settings",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "vendor",
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.zh.md",
    "locale",
    "icon.svg"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ]
    }
  },
  "scripts": {
    "test": "node --import ./test/runtime-loader.mjs --test --test-isolation=none test/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-patch": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    }
  }
}
